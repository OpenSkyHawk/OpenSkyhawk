</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="Firmware/Libraries/CANProtocol/CANProtocol.cpp" line="265" column="6" bodyfile="Firmware/Libraries/CANProtocol/CANProtocol.cpp" bodystart="265" bodyend="269" declfile="Firmware/Libraries/CANProtocol/CANProtocol.h" declline="253" declcolumn="10"/>
